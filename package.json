{
  "name": "storage-manager-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:lib": "ng build storage-manager",
    "test:lib": "ng test storage-manager --no-watch",
    "test:cov": "ng test storage-manager --no-watch --coverage",
    "docs": "compodoc -c .compodocrc.json",
    "docs:serve": "compodoc -c .compodocrc.json -s",
    "build:prod": "ng build storage-manager --configuration production",
    "publish:lib": "npm run test:cov && npm run build:prod && cd dist/storage-manager && npm publish --access public",
    "start:showcase": "ng build storage-manager --configuration development && ng serve showcase",
    "build:showcase": "ng build storage-manager && ng build showcase",
    "test:showcase": "ng test showcase --no-watch",
    "test:showcase:cov": "ng test showcase --no-watch --coverage",
    "lint": "eslint ."
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
